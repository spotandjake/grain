/** A low level micro buffer implementation. */
@noPervasives
module MiniBuffer

from "runtime/unsafe/wasmref" include WasmRef
use WasmRef.{ module WasmArrayRef }
from "runtime/unsafe/wasmi32" include WasmI32
from "runtime/unsafe/dataStructures" include DataStructures as DS

/** A tiny string buffer. */
abstract record MiniBuffer {
  mut data: Bytes,
  mut pos: Number,
}

/**
 * Constructs a new MiniBuffer with the given initial size.
 *
 * @param size: The initial size of the buffer in bytes.
 * @returns A new MiniBuffer instance with the specified initial size.
 */
@unsafe
provide let make = (size: WasmI32) =>
  { data: DS.Bytes.toGrain(DS.Bytes.make(size)), pos: 0 }

@unsafe
let autogrow = (buffer: MiniBuffer, addedSize: WasmI32) => {
  use WasmI32.{ (+), (*), (==), (>=), (<) }
  let bufferRef = DS.Bytes.fromGrain(buffer.data)
  let bufferData = DS.Bytes.getData(bufferRef)
  let mut bufferSize = DS.Bytes.getSize(bufferRef)
  let bufferPosition = DS.untagSimpleNumber(buffer.pos)
  let desiredSize = bufferPosition + addedSize
  if (bufferSize >= desiredSize) return
  if (bufferSize == 0n) bufferSize = 1n
  while (bufferSize < desiredSize) bufferSize *= 2n
  let newBufferRef = DS.Bytes.make(bufferSize)
  let newBufferData = DS.Bytes.getData(newBufferRef)
  WasmArrayRef.copyI8(newBufferData, 0n, bufferData, 0n, bufferPosition)
  buffer.data = DS.Bytes.toGrain(newBufferRef)
  return
}

/**
 * Appends the given string to the MiniBuffer, automatically growing the buffer if necessary.
 *
 * @param str: The string to append to the buffer.
 * @param buffer: The MiniBuffer to which the string will be appended.
 */
@unsafe
provide let addString = (str: String, buffer: MiniBuffer) => {
  use WasmI32.{ (+) }
  let strRef = DS.String.fromGrain(str)
  let strData = DS.String.getData(strRef)
  let strSize = DS.String.getSize(strRef)
  autogrow(buffer, strSize)
  let bufferRef = DS.Bytes.fromGrain(buffer.data)
  let bufferData = DS.Bytes.getData(bufferRef)
  let bufferPosition = DS.untagSimpleNumber(buffer.pos)
  // Write String
  WasmArrayRef.copyI8(bufferData, bufferPosition, strData, 0n, strSize)
  buffer.pos = DS.tagSimpleNumber(bufferPosition + strSize)
}

/**
 * Converts the contents of the MiniBuffer to a String.
 *
 * @param buffer: The MiniBuffer whose contents will be converted to a String.
 *
 * @returns The content of the MiniBuffer as a String.
 */
@unsafe
provide let toString = (buffer: MiniBuffer) => {
  let srcRef = DS.Bytes.fromGrain(buffer.data)
  let srcData = DS.Bytes.getData(srcRef)
  let size = DS.untagSimpleNumber(buffer.pos)
  let dstRef = DS.String.make(size)
  let dstData = DS.String.getData(dstRef)
  WasmArrayRef.copyI8(dstData, 0n, srcData, 0n, size)
  DS.String.toGrain(dstRef): String
}
